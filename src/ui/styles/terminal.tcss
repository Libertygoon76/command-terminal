/* COMMAND TERMINAL — phosphor CRT theme */

$ct-phosphor: #33ff66;
$ct-phosphor-dim: #1f8f3f;
$ct-phosphor-bright: #eaffea;
$ct-amber: #ffb000;
$ct-bg: #040804;
$ct-surface: #081008;
$ct-panel: #0c1a0e;
$ct-cursor: #1f6b30;
$ct-cursor-blur: #0f2e16;

Screen {
    background: $ct-bg;
    color: $ct-phosphor;
}

/* ---------- boot ---------- */

BootScreen {
    background: #000000;
    align: center top;
}

#boot-container {
    width: 96;
    max-width: 100%;
    height: 100%;
    padding: 1 2;
    scrollbar-size: 0 0;
}

#boot-log {
    height: auto;
}

#boot-prompt {
    width: 100%;
    height: 1;
    margin-top: 1;
    content-align: center middle;
    color: $ct-amber;
    text-style: bold;
}

/* ---------- status bar ---------- */

#status-bar {
    height: 3;
    background: $ct-panel;
    border: heavy $ct-phosphor-dim;
}

#sb-title {
    width: 1fr;
    padding: 0 1;
}

.sb-cell {
    width: auto;
    padding: 0 2;
    border-left: vkey $ct-phosphor-dim;
}

/* ---------- workspace ---------- */

#workspace {
    height: 1fr;
}

#sidebar {
    width: 28;
    background: $ct-surface;
    border: heavy $ct-phosphor-dim;
    border-title-color: $ct-amber;
    border-title-style: bold;
}

#nav-list {
    height: auto;
    margin-bottom: 1;
}

#sys-info {
    padding: 1 1;
    border-top: dashed $ct-phosphor-dim;
}

#main-view {
    width: 1fr;
    height: 100%;
    border: heavy $ct-phosphor-dim;
    border-title-color: $ct-amber;
    border-title-style: bold;
}

#comms-log {
    height: 1;
    background: $ct-panel;
}

/* ---------- lists ---------- */

ListView {
    background: transparent;
}

ListItem {
    background: transparent;
    padding: 0 1;
    border-left: blank;
}

ListView > ListItem.-highlight {
    background: $ct-cursor-blur;
    border-left: outer $ct-phosphor-dim;
}

ListView:focus > ListItem.-highlight {
    background: $ct-cursor-blur;
    border-left: outer $ct-amber;
    color: $ct-phosphor-bright;
}

/* ---------- inbox ---------- */

#mail-list {
    width: 52;
    height: 100%;
    border-right: heavy $ct-phosphor-dim;
    border-title-color: $ct-phosphor-dim;
}

#mail-list > MailItem {
    height: 2;
    margin-bottom: 1;
}

#mail-reader {
    width: 1fr;
    padding: 1 2;
}

/* ---------- panels ---------- */

EconomyView, MilitaryView {
    padding: 1 2;
}

.summary {
    height: auto;
    padding: 1 2;
    background: $ct-panel;
    border: round $ct-phosphor-dim;
}

.section-title {
    margin-top: 1;
    height: 1;
}

.module-status {
    margin-top: 1;
    height: auto;
}

/* ---------- war room ---------- */

MapView {
    height: 100%;
}

#map-pane {
    width: 70%;
    height: 100%;
}

#map-canvas {
    height: 1fr;
    background: #02070c;
    scrollbar-size: 1 1;
    scrollbar-color: #1f5f30;
    scrollbar-color-hover: $ct-phosphor-dim;
    scrollbar-color-active: $ct-amber;
    scrollbar-background: #02070c;
}

#map-canvas:focus {
    background-tint: $ct-amber 3%;
}

#order-bar {
    height: 1;
    padding: 0 1;
    background: #02070c;
}

#map-legend {
    height: 4;
    padding: 0 1;
    background: $ct-panel;
    border-top: solid $ct-phosphor-dim;
}

#intel-pane {
    width: 30%;
    height: 100%;
    border-left: heavy $ct-phosphor-dim;
    border-title-color: $ct-amber;
    border-title-style: bold;
}

#intel-scroll {
    height: 1fr;
    padding: 0 1;
}

#intel-readout {
    height: auto;
}

#orbat-list {
    height: 16;
    background: $ct-surface;
    border: none;
    border-top: heavy $ct-phosphor-dim;
    border-title-color: $ct-amber;
    border-title-style: bold;
}

#orbat-list > .option-list--option-highlighted {
    background: $ct-cursor-blur;
}

#orbat-list:focus > .option-list--option-highlighted {
    background: #3a2a00;
}

DataTable {
    height: auto;
    max-height: 20;
    background: transparent;
    margin-top: 1;
}

DataTable > .datatable--header {
    background: $ct-panel;
    color: $ct-amber;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $ct-cursor;
    color: $ct-phosphor-bright;
}

/* ---------- status bar flashes ---------- */

.sb-cell.-up {
    background: #0f3d1a;
}

.sb-cell.-down {
    background: #4a0d0d;
}

/* ---------- sidebar button ---------- */

#advance-week {
    width: 100%;
    margin: 0 1 1 1;
    background: $ct-panel;
    color: $ct-amber;
    border: tall $ct-amber;
    text-style: bold;
}

#advance-week:hover, #advance-week:focus {
    background: #3a2a00;
}

#advance-week:disabled {
    color: #ff3b3b;
    border: tall #8b0000;
}

/* ---------- reply buttons ---------- */

#reply-panel {
    height: auto;
    margin-top: 1;
}

.reply-button {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    background: $ct-panel;
    color: $ct-phosphor-bright;
    border: tall $ct-phosphor-dim;
    content-align: left middle;
    text-align: left;
}

.reply-button:hover, .reply-button:focus {
    background: #1a3a1f;
    border: tall $ct-amber;
    color: $ct-amber;
}

/* ---------- confirm dialog ---------- */

ConfirmReplyScreen {
    align: center middle;
    background: #000000 70%;
}

#confirm-dialog {
    width: 76;
    height: auto;
    padding: 1 2;
    background: $ct-surface;
    border: heavy $ct-amber;
    border-title-color: $ct-amber;
    border-title-style: bold;
}

#confirm-text {
    height: auto;
}

#confirm-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: center;
}

#confirm-buttons Button {
    margin: 0 2;
    background: $ct-panel;
    color: $ct-phosphor-bright;
    border: tall $ct-phosphor-dim;
}

#confirm-buttons Button:focus {
    border: tall $ct-amber;
    color: $ct-amber;
}

/* ---------- coordinates dialog ---------- */

CoordinatesScreen {
    align: center middle;
    background: #000000 70%;
}

#coords-dialog {
    width: 72;
    height: auto;
    padding: 1 2;
    background: $ct-surface;
    border: heavy #4fd8ff;
    border-title-color: #4fd8ff;
    border-title-style: bold;
}

#coords-input {
    margin-top: 1;
    background: $ct-panel;
    color: $ct-phosphor-bright;
    border: tall $ct-phosphor-dim;
}

#coords-input:focus {
    border: tall #4fd8ff;
}

#coords-error {
    height: 1;
}

/* ---------- toasts ---------- */

Toast {
    background: $ct-panel;
    border-left: outer $ct-amber;
}

/* ---------- game over ---------- */

GameOverScreen {
    align: center middle;
    background: #200000 85%;
}

#gameover-dialog {
    width: 96;
    height: 80%;
    padding: 1 2;
    background: #0a0404;
    border: heavy #ff3b3b;
    border-title-color: #ff3b3b;
    border-title-style: bold;
}

#gameover-title {
    height: 1;
    margin-bottom: 1;
}

#gameover-body {
    height: 1fr;
}

#gameover-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: center;
}

#gameover-buttons Button {
    margin: 0 2;
    background: $ct-panel;
    color: $ct-phosphor-bright;
    border: tall #8b0000;
}

#gameover-buttons Button:focus {
    border: tall $ct-amber;
    color: $ct-amber;
}

ResearchView {
    padding: 1 2;
}

/* ---------- air assets ---------- */

AirView {
    padding: 1 2;
}

#air-wings, #air-sectors {
    height: auto;
    max-height: 22;
}

/* ---------- classified dilemma ---------- */

DilemmaScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

#dilemma-dialog {
    width: 110;
    max-width: 96%;
    height: auto;
    max-height: 92%;
    padding: 1 2;
    background: #0c0a02;
    border: double $ct-amber;
    border-title-color: $ct-amber;
    border-title-style: bold;
}

#dilemma-meta, #dilemma-title {
    height: auto;
    margin-bottom: 1;
}

#dilemma-body {
    height: auto;
    max-height: 14;
    margin-bottom: 1;
}

#dilemma-choices {
    height: auto;
}

.dilemma-choice {
    width: 1fr;
    height: auto;
    min-height: 7;
    margin: 0 1;
    padding: 0 1;
    content-align: left top;
    text-align: left;
    background: $ct-panel;
    color: $ct-phosphor-bright;
    border: tall $ct-phosphor-dim;
}

.dilemma-choice:focus, .dilemma-choice:hover {
    border: tall $ct-amber;
    background: #1a1404;
    text-style: none;
}

#dilemma-footer {
    height: 1;
    margin-top: 1;
}

/* ---------- victory ---------- */

GameOverScreen.-victory {
    background: #1a1400 85%;
}

GameOverScreen.-victory #gameover-dialog {
    background: #0a0a02;
    border: double $ct-amber;
    border-title-color: $ct-amber;
}

/* ---------- critical emergency (crises) ---------- */

DilemmaScreen.-emergency {
    background: rgba(40, 0, 0, 0.8);
}

DilemmaScreen.-emergency #dilemma-dialog {
    background: #120404;
    border: double #ff3b3b;
    border-title-color: #ff3b3b;
}

/* ---------- expansion 1.1: diplomacy & cities ---------- */

DiplomacyView, CitiesView {
    padding: 1 2;
}

#dip-nations, #dip-catalog, #dip-shipments, #city-table {
    height: auto;
    max-height: 30;
}

#city-panels {
    height: auto;
    min-height: 24;
    margin-top: 1;
}

#city-detail {
    width: 1fr;
    padding: 0 1;
}

#city-news-scroll {
    width: 1fr;
    height: 24;
    padding: 0 1;
    border: round $ct-phosphor-dim;
    border-title-color: $ct-amber;
}
